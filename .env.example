# Token del bot (Developer Portal > Bot > Reset Token). NUNCA lo subas a git.
DISCORD_TOKEN=
# Application ID (Developer Portal > General Information)
CLIENT_ID=
# ID de tu servidor (clic derecho en el servidor > Copiar ID, con Modo desarrollador activo)
GUILD_ID=
# Opcional: token personal de GitHub (permiso "Webhooks: read & write" en los repos)
# para que el bot conecte los repos solo. Sin él, el bot muestra los pasos para hacerlo a mano.
GITHUB_PAT=
