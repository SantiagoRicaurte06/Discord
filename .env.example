# Token del bot (Developer Portal > Bot > Reset Token). NUNCA lo subas a git.
DISCORD_TOKEN=
# Application ID (Developer Portal > General Information)
CLIENT_ID=
# ID de tu servidor (clic derecho en el servidor > Copiar ID, con Modo desarrollador activo)
GUILD_ID=
# Token de GitHub (fine-grained) para leer los issues, incluidos repos privados.
# Permisos mínimos: "Issues: Read-only" (y "Metadata: Read-only", que va incluido).
# Opcional "Webhooks: Read and write" para que el bot conecte el canal de commits solo.
# El bot nunca cierra ni modifica issues.
GITHUB_PAT=
# Carpeta de la base de datos (en el hosting, apúntala a un volumen persistente, ej. /data)
DATA_DIR=
