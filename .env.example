# Token del bot (Developer Portal > Bot > Reset Token). NUNCA lo subas a git.
DISCORD_TOKEN=
# Application ID (Developer Portal > General Information)
CLIENT_ID=
# ID de tu servidor (clic derecho en el servidor > Copiar ID, con Modo desarrollador activo)
GUILD_ID=
# Token de GitHub. Recomendado: fine-grained con acceso a "All repositories" y permisos:
#   Administration: Read and write  → crear el repo de cada proyecto e invitar/quitar colaboradores
#   Issues: Read-only               → leer los issues (el bot nunca los modifica)
#   Webhooks: Read and write        → conectar el canal de commits solo
#   (Metadata: Read-only va incluido)
# Alternativa: token clásico con el scope "repo".
GITHUB_PAT=
# Client ID de una OAuth App de GitHub con "Enable Device Flow" activado, para /github vincular
# (cada persona inicia sesión en GitHub y así se verifica que la cuenta es suya). No hace falta el client secret.
GITHUB_CLIENT_ID=
# Cuenta u organización donde se crean los repos (vacío = el dueño del token)
GITHUB_OWNER=
# Repos nuevos privados (true por defecto)
GITHUB_REPO_PRIVADO=true
# Usuario de Discord responsable por defecto de los proyectos aprobados (vacío = dueño del servidor)
RESPONSABLE_ID=
# Carpeta de la base de datos (en el hosting, apúntala a un volumen persistente, ej. /data)
DATA_DIR=
# Resumen semanal (lunes): zona horaria y hora local de publicación
RESUMEN_TZ=America/Bogota
RESUMEN_HORA=9
# Hora local (0-23, zona RESUMEN_TZ) de la revisión diaria de actualizaciones de las skills
SKILLS_HORA=2
